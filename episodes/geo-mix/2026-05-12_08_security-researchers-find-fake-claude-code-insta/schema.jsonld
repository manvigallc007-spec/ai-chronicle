          "item": {
            "@type": "NewsArticle",
            "headline": "Security researchers find fake Claude Code installers stealing developer credentials via cookie theft",
            "articleSection": "Policy & Rights",
            "abstract": "Attackers have been distributing fraudulent installers impersonating Anthropic's Claude Code developer tool to steal session cookies and developer credentials from software engineers. The malicious packages exploited a Windows COM interface to elevate privileges and exfiltrate authentication tokens, giving attackers persistent access to victims' development environments and potentially their employers' codebases. Security researchers warn the campaign targets developers specifically because their compromised accounts can provide access to source code, cloud infrastructure, and CI/CD pipelines.",
            "url": "https://www.theregister.com/security/2026/05/11/cookie-thieves-caught-stealing-dev-secrets/5238248",
            "publisher": {
              "@type": "NewsMediaOrganization",
              "name": "The AI Chronicle",
              "url": "https://theaichronicle.com",
              "logo": {
                "@type": "ImageObject",
                "url": "https://theaichronicle.com/logo.png"
              },
              "sameAs": [
