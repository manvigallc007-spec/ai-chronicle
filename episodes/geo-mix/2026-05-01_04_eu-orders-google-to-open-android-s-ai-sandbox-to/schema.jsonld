          "@type": "ListItem",
          "position": 1,
          "item": {
            "@type": "NewsArticle",
            "headline": "EU orders Google to open Android's AI sandbox to rival assistants under Digital Markets Act",
            "articleSection": "Policy & Rights",
            "abstract": "The European Commission is moving to require Google to open its Android AI sandbox — currently giving Gemini privileged deep-device access — to competing AI assistants under the Digital Markets Act. The measures would compel Google to grant rival services the same system-level integration it provides to its own AI, affecting billions of Android users globally. This is one of the most concrete AI competition enforcement actions taken under the DMA to date and sets a precedent for platform-level AI access rules.",
            "url": "https://go.theregister.com/feed/www.theregister.com/2026/04/28/ai_competition_in_android_phones/",
            "publisher": {
              "@type": "NewsMediaOrganization",
              "name": "The AI Chronicle",
              "url": "https://theaichronicle.com",
              "logo": {
                "@type": "ImageObject",
                "url": "https://theaichronicle.com/logo.png"
              },
