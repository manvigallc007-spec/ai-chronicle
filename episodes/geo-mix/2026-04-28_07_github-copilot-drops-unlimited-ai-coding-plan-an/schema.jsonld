          "item": {
            "@type": "NewsArticle",
            "headline": "GitHub Copilot drops unlimited AI coding plan and shifts to metered billing as costs spiral",
            "articleSection": "Job Evolution",
            "abstract": "Microsoft's GitHub is ending its flat-rate unlimited AI offering for Copilot customers, moving to a metered billing model that charges developers based on actual AI usage. The company acknowledged it can no longer sustain the all-you-can-eat pricing model as AI inference costs mount. The change will directly affect millions of developers worldwide who have come to rely on Copilot for daily coding assistance, and signals a broader industry reckoning with the true cost of AI productivity tools.",
            "url": "https://go.theregister.com/feed/www.theregister.com/2026/04/28/microsofts_github_shifts_to_metered/",
            "publisher": {
              "@type": "NewsMediaOrganization",
              "name": "The AI Chronicle",
              "url": "https://theaichronicle.com",
              "logo": {
